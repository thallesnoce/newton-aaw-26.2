    {
      "name": "FALHA 10 · AULA 10 · Contrato OpenAPI",
      "description": "O contrato diz o que a API faz, inclusive a segurança.",
      "item": [
        {
          "name": "Lê o contrato",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const spec = pm.response.json();",
                  "const respostas = spec.paths['/api/v1/pedidos'].post.responses;",
                  "pm.test('F10 · o POST de pedidos documenta 201, e não 200', () => {",
                  "  pm.expect(respostas).to.have.property('201');",
                  "  pm.expect(respostas).to.not.have.property('200');",
                  "});",
                  "pm.test('F10 · o POST de pedidos documenta os erros 400, 401, 404 e 409', () => {",
                  "  pm.expect(respostas).to.include.all.keys('400', '401', '404', '409');",
                  "});",
                  "pm.test('F10 · o contrato declara o esquema Bearer (JWT)', () => {",
                  "  const esquemas = Object.values((spec.components || {}).securitySchemes || {});",
                  "  pm.expect(esquemas.some(e => (e.scheme || '').toLowerCase() === 'bearer' ||",
                  "    (e.type === 'apiKey' && e.name === 'Authorization'))).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/swagger/v1/swagger.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "swagger",
                "v1",
                "swagger.json"
              ]
            }
          }
        }
