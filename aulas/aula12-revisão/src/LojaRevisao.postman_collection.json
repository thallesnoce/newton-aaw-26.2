    {
      "name": "FALHA 03 · AULA 03 · Design da URI",
      "description": "Sem verbo na URI, GET não altera dados: DELETE /api/v1/pedidos/{id} responde 204.",
      "item": [
        {
          "name": "João cria um pedido para cancelar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('pedidoCancelar', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenJoao}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pedidos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itens\": [\n    {\n      \"produtoId\": 2,\n      \"quantidade\": 1\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Rota antiga não pode cancelar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('F03 · a rota com verbo na URI não existe mais', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenJoao}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cancelarPedido?id={{pedidoCancelar}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "cancelarPedido"
              ],
              "query": [
                {
                  "key": "id",
                  "value": "{{pedidoCancelar}}"
                }
              ]
            }
          }
        },
        {
          "name": "O pedido continua lá",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('F03 · um GET não cancelou o pedido', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenJoao}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pedidos/{{pedidoCancelar}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pedidos",
                "{{pedidoCancelar}}"
              ]
            }
          }
        },
        {
          "name": "Cancela do jeito REST",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('F03 · DELETE responde 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenJoao}}"
              }
            ],
            "url": {
