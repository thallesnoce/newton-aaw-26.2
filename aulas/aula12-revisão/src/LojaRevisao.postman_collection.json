    {
      "name": "FALHA 04 · AULA 04 · Paginação",
      "description": "?page e ?size, envelope Pagina<T> e teto de 100 itens no servidor.",
      "item": [
        {
          "name": "Página de 10 itens",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('F04 · devolve o envelope com 10 itens', () => {",
                  "  pm.expect(body.items).to.be.an('array');",
                  "  pm.expect(body.items.length).to.eql(10);",
                  "});",
                  "pm.test('F04 · a página 2 começa no 11º produto', () => pm.expect(body.items && body.items[0].id).to.eql(11));",
                  "pm.test('F04 · informa page, size e total', () => {",
                  "  pm.expect(body.page).to.eql(2);",
                  "  pm.expect(body.size).to.eql(10);",
                  "  pm.expect(body.total).to.be.at.least(2000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/produtos?page=2&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "produtos"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "2"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Tentativa de baixar tudo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('F04 · o servidor impõe teto de 100 itens', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.items).to.be.an('array');",
                  "  pm.expect(body.items.length).to.be.at.most(100);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/produtos?page=1&size=100000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "produtos"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "size",
                  "value": "100000"
                }
              ]
            }
          }
        }
      ]
